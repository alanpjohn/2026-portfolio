{
  "name": "2026-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "velite && next build",
    "start": "next start",
    "lint": "eslint ./src/",
    "velite": "velite",
    "content:backup": "bunx tsx scripts/sync-content.ts backup",
    "content:restore": "bunx tsx scripts/sync-content.ts restore",
    "content:ensure": "bunx tsx scripts/sync-content.ts ensure",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@opennextjs/cloudflare": "^1.14.8",
    "@resvg/resvg-js": "^2.6.2",
    "framer-motion": "^12.25.0",
    "next": "15.5.9",
    "next-themes": "^0.4.6",
    "plaiceholder": "^3.0.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "rehype-highlight": "^7.0.2",
    "rehype-highlight-code-lines": "^1.2.1",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "velite": "^0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.28",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.58.0"
  }
}
