{
    "name": "2026-portfolio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "bun run optimize-images && velite && next build",
        "build:audit": "bun run optimize-images && velite && INCLUDE_ALL=true next build",
        "start": "bunx serve@latest out",
        "lint": "eslint ./src/",
        "velite": "velite",
        "optimize-images": "bunx tsx scripts/optimize-images.ts",
        "content:backup": "bunx tsx scripts/sync-content.ts backup",
        "content:restore": "bunx tsx scripts/sync-content.ts restore",
        "content:ensure": "bunx tsx scripts/sync-content.ts ensure",
        "deploy:pages": "bun run optimize-images && velite && next build && wrangler pages deploy ./out --project-name=2026-portfolio-static",
        "audit:lighthouse": "lhci autorun --config=.lighthouserc.js"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.1.0",
        "@fortawesome/free-brands-svg-icons": "^7.1.0",
        "@fortawesome/free-solid-svg-icons": "^7.1.0",
        "@fortawesome/react-fontawesome": "^3.1.1",
        "@resvg/resvg-js": "^2.6.2",
        "framer-motion": "^12.31.0",
        "next": "^16.1.6",
        "next-themes": "^0.4.6",
        "plaiceholder": "^3.0.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "rehype-highlight": "^7.0.2",
        "rehype-highlight-code-lines": "^1.2.1",
        "satori": "^0.19.1",
        "sharp": "^0.34.5",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "velite": "^0.3.1"
    },
    "devDependencies": {
        "@lhci/cli": "^0.15.1",
        "@tailwindcss/postcss": "^4.1.18",
        "@types/node": "^25.2.0",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "@types/unist": "^3.0.3",
        "eslint": "^9.39.2",
        "eslint-config-next": "^16.1.6",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.3",
        "wrangler": "^4.62.0"
    }
}
